# Supabase Postgres. Find both strings in the Supabase dashboard:
# Project Settings > Database > Connection string (click "Connect").
#
# Pooled connection (Transaction pooler, port 6543). Used by the running app.
# Keep ?pgbouncer=true so Prisma works with the pooler.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432, or the Session pooler). Used by `prisma db push` / migrate.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Admin dashboard (/admin). Leave blank and the dashboard stays locked.
# ADMIN_PASSWORD needs 12+ characters.
ADMIN_PASSWORD=""

# Random string, 32+ characters, used to sign the admin session cookie (required).
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=""

# Where uploaded payment receipts are stored. Keep this OUTSIDE /public.
RECEIPTS_DIR="./storage/receipts"

# Bank transfer details shown on the payment page.
BANK_NAME="OPAY"
BANK_ACCOUNT_NUMBER="8167260937"
BANK_ACCOUNT_NAME="Wisdom Nso"

# Studio contact details shown on the contact page.
STUDIO_PHONE_DISPLAY="+234 814 002 8555"
STUDIO_PHONE_TEL="+2348140028555"
STUDIO_EMAIL="nsowisdom408@gmail.com"
